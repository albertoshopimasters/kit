{% assign sizes = "XS,S,M,L,XL,2XL,3XL" | split: "," %}

<div class="kit-section">
  <div class="kit-section-header">
    <h4>{{ 'customization.sizes.title' | t | default: 'Elige tu talla' }}</h4>
    <div class="kit-sizes-guide">
      <span>{{ 'customization.sizes.guide.title' | t | default: 'Guía de tallas' }}</span>
    </div>
  </div>
  
  <div class="container-radio-elements">
    {% for size in sizes %}
      {% render 'element-radio', 
        name: 'size',
        value: size, 
        title: size, 
        active: false,
        disabled: false,
        style: 'style-2' 
      %}
    {% endfor %}
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  
  const sizeRadios = document.querySelectorAll('.kit-section .radio-option');
  
  sizeRadios.forEach(function(option) {
    option.addEventListener('click', function() {
      if (this.classList.contains('is-disabled')) {
        return;
      }
      
      const container = this.closest('.kit-section .container-radio-elements');
      if (!container) return;
      
      const allSizes = container.querySelectorAll('.radio-option');
      allSizes.forEach(function(size) {
        size.classList.remove('is-active');
        const input = size.querySelector('input[type="radio"]');
        if (input) input.checked = false;
      });
      
      this.classList.add('is-active');
      const selectedInput = this.querySelector('input[type="radio"]');
      if (selectedInput) {
        selectedInput.checked = true;
      }
      

      document.dispatchEvent(new CustomEvent('sizeChanged', {
        detail: {
          size: selectedInput ? selectedInput.value : '',
          element: this
        }
      }));
    });
  });
  
  setTimeout(function() {
    const defaultSize = document.querySelector('.kit-section .radio-option input[value="M"]');
    if (defaultSize) {
      defaultSize.closest('.radio-option').click();
    }
  }, 100);
  
});

document.addEventListener('genderChanged', function(event) {
  const selectedGender = event.detail.value.toLowerCase();
  const sizeOptions = document.querySelectorAll('.kit-section .radio-option');
  
  sizeOptions.forEach(function(sizeOption) {
    const sizeValue = sizeOption.querySelector('input').value;
    let shouldDisable = false;
    
    if (selectedGender === 'bebe') {
      shouldDisable = !['XS'].includes(sizeValue);
    } else if (selectedGender === 'niño/a') {
      shouldDisable = !['XS', 'S', 'M', 'L'].includes(sizeValue);
    }
    
    if (shouldDisable) {
      sizeOption.classList.add('is-disabled');
      sizeOption.classList.remove('is-active');
    } else {
      sizeOption.classList.remove('is-disabled');
    }
  });
  
  const currentActive = document.querySelector('.kit-section .radio-option.is-active');
  if (!currentActive || currentActive.classList.contains('is-disabled')) {
    const firstAvailable = document.querySelector('.kit-section .radio-option:not(.is-disabled)');
    if (firstAvailable) {
      firstAvailable.click();
    }
  }
});
</script>