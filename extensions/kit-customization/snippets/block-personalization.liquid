{% assign section_title = 'customization.personalization.title' | t | default: 'Personalización' %}

<div class="kit-section">
 {% render 'component-section-header', section_title: section_title, price_value: '+20€' %}
 
 <div class="kit-personalization-tabs">
  <button class="kit-personalization-tab active" data-tab="player">
   {{ 'customization.personalization.tabs.player.title' | t | default: 'Jugador/a' }}
  </button>
  <button class="kit-personalization-tab" data-tab="custom">
   {{ 'customization.personalization.tabs.custom.title' | t | default: 'Tu nombre' }}
  </button>
 </div>
 
 <div class="kit-tab-content">
  {% render 'component-tab-player' %}
  {% render 'component-tab-custom' %}
 </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
 // Selecciona todos los botones y contenedores de las pestañas
  const tabButtons = document.querySelectorAll('.kit-personalization-tab');
  const tabContainers = document.querySelectorAll('.kit-personalization-tab-container');

  // Función para mostrar/ocultar los contenidos de las pestañas
  function showTab(tabName) {
    // Primero, oculta todos los contenedores de las pestañas
    tabContainers.forEach(container => {
      container.style.display = 'none';
    });
 
    // Luego, muestra el contenedor de la pestaña que coincida con el nombre
    const targetContainer = document.getElementById('kit-tab-' + tabName);
    if (targetContainer) {
      targetContainer.style.display = 'block';
    }
  }
 
 // Establece el estado inicial: mostrar la pestaña del jugador por defecto
showTab('player');

// Agrega un "click listener" a cada botón de pestaña
  tabButtons.forEach(button => {
    button.addEventListener('click', function() {
      const targetTab = this.getAttribute('data-tab');

      // Remueve la clase 'active' de todos los botones
      tabButtons.forEach(btn => {
        btn.classList.remove('active');
      });

      // Agrega la clase 'active' al botón clickeado
      this.classList.add('active');

      // Muestra el contenido de la pestaña correspondiente
      showTab(targetTab);
    });
  });
});
</script>