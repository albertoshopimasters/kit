<!-- snippets/component-equipment-item.liquid SIN IMAGEN -->
<div 
  class="kit-equipment-item {% if equipment.active or is_first %}active{% endif %}"
  data-type="{{ equipment.type | default: 'home' }}"
  data-id="{{ equipment.id }}"
  data-price="{{ equipment.price }}"
  data-tooltip="{{ equipment.name | default: equipment.title }}"
  onclick="selectEquipment(this)"
>
  <span></span>
</div>