<label class="radio-option {{ style }} {% if disabled %}is-disabled{% endif %} {% if active %}is-active{% endif %}">
  <input
    type="radio"
    name="{{ name }}"
    value="{{ value }}"
    {% if active %}
      checked
    {% endif %}
    {% if disabled %}
      disabled
    {% endif %}
  >
 {% comment %}
    Conditional rendering based on the name of the radio group.
    If the name is 'competition', we render an image.
    Otherwise, we render the title as text.
  {% endcomment %}
  {% if name == 'competition' %}
    {% assign image_url = value | handleize | prepend: 'logo-' | append: '.png' | asset_url %}
    <img src="{{ image_url }}" alt="{{ title }}" style="height: 30px;">
  {% else %}
    <span>{{ title }}</span>
  {% endif %}
</label>

<script>
document.addEventListener('DOMContentLoaded', function() {
  
  const radioOptions = document.querySelectorAll('.radio-option');
  
  radioOptions.forEach(function(option) {
    option.addEventListener('click', function() {
      if (this.classList.contains('is-disabled')) {
        return;
      }
      
      const container = this.closest('.container-radio-elements');
      if (!container) return;
      
      const allRadios = container.querySelectorAll('.radio-option');
      allRadios.forEach(function(radio) {
        radio.classList.remove('is-active');
        const input = radio.querySelector('input[type="radio"]');
        if (input) {
          input.checked = false;
        }
      });
      
      this.classList.add('is-active');
      
      const selectedInput = this.querySelector('input[type="radio"]');
      if (selectedInput) {
        selectedInput.checked = true;
      }
      
      const selectedValue = selectedInput ? selectedInput.value : '';
      document.dispatchEvent(new CustomEvent('genderChanged', {
        detail: {
          value: selectedValue,
          element: this
        }
      }));
    });
  });
  
  const containers = document.querySelectorAll('.container-radio-elements');
  containers.forEach(function(container) {
    const activeRadio = container.querySelector('.radio-option.is-active');
    if (!activeRadio) {
      const firstRadio = container.querySelector('.radio-option:not(.is-disabled)');
      if (firstRadio) {
        firstRadio.click();
      }
    }
  });
});
</script>